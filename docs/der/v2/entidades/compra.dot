graph E {
  graph [layout=twopi, root=COMPRA, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  COMPRA [shape=box, style="filled", fillcolor="#E8F2FC", color="#1F5A8A", penwidth=2, label=<<B>COMPRA</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_compra</U>>];
  COMPRA -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="data_compra"];
  COMPRA -- a1;
  a2 [shape=ellipse, style="dashed", peripheries=1, label="valor_compra"];
  COMPRA -- a2;
}