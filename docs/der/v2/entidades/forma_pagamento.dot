graph E {
  graph [layout=twopi, root=FORMA_PAGAMENTO, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  FORMA_PAGAMENTO [shape=box, style="filled", fillcolor="#E6F6EA", color="#1F5A8A", penwidth=2, label=<<B>FORMA_PAGAMENTO</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_forma_Pagamento</U>>];
  FORMA_PAGAMENTO -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="tipo_forma_pagamento"];
  FORMA_PAGAMENTO -- a1;
}