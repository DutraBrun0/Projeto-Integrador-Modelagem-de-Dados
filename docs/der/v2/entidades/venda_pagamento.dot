graph E {
  graph [layout=twopi, root=VENDA_PAGAMENTO, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  VENDA_PAGAMENTO [shape=box, style="filled", fillcolor="#E8F2FC", color="#1F5A8A", penwidth=2, label=<<B>VENDA_PAGAMENTO</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_venda_pagamento</U>>];
  VENDA_PAGAMENTO -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="valor_pago"];
  VENDA_PAGAMENTO -- a1;
}