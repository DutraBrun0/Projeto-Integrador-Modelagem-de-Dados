graph E {
  graph [layout=twopi, root=CATEGORIA, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  CATEGORIA [shape=box, style="filled", fillcolor="#E8F2FC", color="#1F5A8A", penwidth=2, label=<<B>CATEGORIA</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_categoria</U>>];
  CATEGORIA -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="tipo_categoria"];
  CATEGORIA -- a1;
}