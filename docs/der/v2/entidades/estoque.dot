graph E {
  graph [layout=twopi, root=ESTOQUE, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  ESTOQUE [shape=box, style="filled", fillcolor="#E6F6EA", color="#1F5A8A", penwidth=2, label=<<B>ESTOQUE</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_estoque</U>>];
  ESTOQUE -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="quantidade_atual"];
  ESTOQUE -- a1;
  a2 [shape=ellipse, style="solid", peripheries=1, label="quantidade_minima"];
  ESTOQUE -- a2;
}