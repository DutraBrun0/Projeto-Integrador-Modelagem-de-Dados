graph E {
  graph [layout=twopi, root=HISTORICO_SALARIO, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  HISTORICO_SALARIO [shape=box, style="filled", fillcolor="#E6F6EA", color="#1F5A8A", penwidth=2, label=<<B>HISTORICO_SALARIO</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_historico_salario</U>>];
  HISTORICO_SALARIO -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="salario"];
  HISTORICO_SALARIO -- a1;
  a2 [shape=ellipse, style="solid", peripheries=1, label="data_inicio"];
  HISTORICO_SALARIO -- a2;
  a3 [shape=ellipse, style="solid", peripheries=1, label="data_fim"];
  HISTORICO_SALARIO -- a3;
}