graph E {
  graph [layout=twopi, root=VENDA, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  VENDA [shape=box, style="filled", fillcolor="#E8F2FC", color="#1F5A8A", penwidth=2, label=<<B>VENDA</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_venda</U>>];
  VENDA -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="Data_Venda"];
  VENDA -- a1;
  a2 [shape=ellipse, style="solid", peripheries=1, label="Status_Venda"];
  VENDA -- a2;
  a3 [shape=ellipse, style="dashed", peripheries=1, label="valor_venda"];
  VENDA -- a3;
}