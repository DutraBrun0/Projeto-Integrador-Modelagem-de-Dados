graph E {
  graph [layout=twopi, root=NOTA_FISCAL, ranksep=1.25, overlap=false, pad=0.25, fontname="Helvetica", splines=true];
  node [fontname="Helvetica", fontsize=13];
  edge [color="#36536B"];
  NOTA_FISCAL [shape=box, style="filled", fillcolor="#E6F6EA", color="#1F5A8A", penwidth=2, label=<<B>NOTA_FISCAL</B>>, width=2.6, height=0.8];
  a0 [shape=ellipse, style="solid", peripheries=1, label=<<U>id_nota_fiscal</U>>];
  NOTA_FISCAL -- a0;
  a1 [shape=ellipse, style="solid", peripheries=1, label="numero_nota"];
  NOTA_FISCAL -- a1;
  a2 [shape=ellipse, style="solid", peripheries=1, label="valor_pago"];
  NOTA_FISCAL -- a2;
  a3 [shape=ellipse, style="solid", peripheries=1, label="data_emissao"];
  NOTA_FISCAL -- a3;
  a4 [shape=ellipse, style="solid", peripheries=1, label="valor_impostos"];
  NOTA_FISCAL -- a4;
}